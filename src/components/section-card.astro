---
interface Props {
  title: string
  iconBgColor?: string
  class?: string
  id?: string
}

const {
  title,
  iconBgColor = 'bg-gray-100',
  class: className = '',
  id,
} = Astro.props
---

<div id={id} class:list={['bg-white p-6 rounded-lg shadow-sm', className]}>
  <div class="flex flex-col sm:flex-row sm:items-start sm:space-x-4">
    <div class="flex items-center gap-3 sm:block mb-3 sm:mb-0">
      <div
        class:list={[
          'w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0',
          iconBgColor,
        ]}
      >
        <slot name="icon" />
      </div>
      <h3 class="text-xl font-semibold sm:hidden">{title}</h3>
    </div>
    <div class="flex-1">
      <h3 class="text-xl font-semibold mb-3 hidden sm:block">{title}</h3>
      <slot />
    </div>
  </div>
</div>
