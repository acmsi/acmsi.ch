---
export interface BreadcrumbItem {
  href?: string
  label: string
}

interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props
---

<section class="py-8 bg-white/70 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav
      aria-label="Fil d’Ariane"
      class="flex flex-wrap items-start gap-x-2 gap-y-1 text-sm text-gray-600"
    >
      {
        items.map((item, index) => (
          <div
            class:list={[
              'flex items-start gap-2',
              item.href ? 'shrink-0' : 'min-w-0',
            ]}
          >
            {item.href ? (
              <a href={item.href} class="hover:text-teal-600 transition-colors">
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="min-w-0 break-words">
                {item.label}
              </span>
            )}
            {index < items.length - 1 && (
              <span aria-hidden="true" class="shrink-0">
                /
              </span>
            )}
          </div>
        ))
      }
    </nav>
  </div>
</section>
