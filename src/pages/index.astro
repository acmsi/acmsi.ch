---
import Layout from '@/layouts/Layout.astro'
import {
  UsersThreeIcon,
  BookOpenIcon,
  MosqueIcon,
  ClockIcon,
  LetterCirclePIcon,
} from '@phosphor-icons/react/dist/ssr'
import { getProjectSummary } from '@/lib/content'
import ProjectBanner from '@/components/project-banner.astro'

const projectData = await getProjectSummary()
---

<Layout
  title="Accueil - ACMSI"
  description="Association Culturelle Musulmane de Saint-Imier - La mosquée Nur accueille la communauté musulmane du Jura bernois."
>
  <!-- Hero Section -->
  <section
    class="py-20 bg-linear-to-b from-white/20 via-white/60 to-white/80 lg:py-32 overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center relative z-10">
        <h1 class="text-4xl lg:text-6xl font-bold mb-3">
          Bienvenue à la Mosquée Nur
        </h1>
        <p class="text-xl lg:text-2xl max-w-4xl mx-auto mb-12">
          Association Culturelle Musulmane de Saint-Imier - Un lieu de paix, de
          prière et de communauté au cœur du Jura bernois, guidé par les valeurs
          d&rsquo;<strong>Ihsan</strong>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/actualites"
            class="bg-gray-900 text-white px-8 py-4 rounded-lg font-medium hover:bg-gray-800 transition-colors"
          >
            Voir les actualités
          </a>
          <a
            href="/contact"
            class="bg-white text-gray-900 px-8 py-4 rounded-lg font-medium border-2 border-gray-300 hover:bg-gray-50 transition-colors"
          >
            Nous trouver
          </a>
        </div>

        <!-- Section Jumma -->
        <div class="mt-8 text-sm sm:text-base">
          <div
            class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 sm:gap-8"
          >
            <a
              href="/contact#jumma"
              class="flex items-center gap-2 text-gray-700 hover:text-nur-teal-600 transition-colors"
            >
              <MosqueIcon
                className="w-5 h-5 text-nur-teal-600"
                weight="duotone"
              />
              <span class="font-medium">Jumma : 12h15</span>
              <span class="text-gray-500">(Salat 12h30)</span>
            </a>

            <a
              href="/contact#horaires-prieres"
              class="flex items-center gap-1 text-nur-teal-600 hover:underline"
            >
              <ClockIcon className="w-4 h-4" weight="duotone" />
              Horaires des prières
            </a>

            <a
              href="/contact#parking-info"
              class="flex items-center gap-1 text-gray-600 hover:underline"
            >
              <LetterCirclePIcon
                className="w-4 h-4 text-blue-500"
                weight="duotone"
              />
              Informations Stationnement
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Banner -->
  {
    projectData && (
      <ProjectBanner
        variant="full"
        showProgress={true}
        totalAmount={projectData.total_objectif}
        raisedAmount={projectData.total_leve}
        percentage={projectData.pourcentage_global}
      />
    )
  }

  <!-- Mission Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-3">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Notre Mission</h2>
        <div class="max-w-4xl mx-auto text-lg">
          <p>
            L&rsquo;Association Culturelle Musulmane de Saint-Imier (ACMSI) a
            pour mission de servir la communauté musulmane locale et de
            promouvoir l&rsquo;excellence dans la pratique religieuse et les
            relations humaines.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Nos Services</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <UsersThreeIcon
              className="w-8 h-8 text-gray-600"
              weight="duotone"
            />
          </div>
          <h3 class="text-xl font-semibold mb-2">Prières quotidiennes</h3>
          <p>Cinq prières quotidiennes dans un cadre paisible et spirituel</p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <UsersThreeIcon
              className="w-8 h-8 text-gray-600"
              weight="duotone"
            />
          </div>
          <h3 class="text-xl font-semibold mb-2">Prière du vendredi</h3>
          <p>Khutbah et prière communautaire chaque vendredi</p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <BookOpenIcon className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Éducation islamique</h3>
          <p>
            Cours d&rsquo;arabe et d&rsquo;éducation religieuse pour tous les
            âges
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <BookOpenIcon className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Événements communautaires</h3>
          <p>Cérémonies religieuses et activités sociales</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl text-white font-bold mb-6">
        Rejoignez Notre Communauté
      </h2>
      <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
        Découvrez un lieu de spiritualité et de fraternité au cœur de
        Saint-Imier
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/actualites"
          class="bg-white text-gray-900 px-8 py-4 rounded-lg font-medium hover:bg-gray-100 transition-colors"
        >
          Lire nos actualités
        </a>
        <a
          href="/donation"
          class="border-2 border-white text-white px-8 py-4 rounded-lg font-medium hover:bg-white hover:text-gray-900 transition-colors"
        >
          Faire un don
        </a>
      </div>
    </div>
  </section>
</Layout>
