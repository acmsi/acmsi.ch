---
import Layout from '@/layouts/Layout.astro'
import {
  UsersThreeIcon,
  BookOpenIcon,
  HeartIcon,
  ClockCounterClockwiseIcon,
  MosqueIcon,
} from '@phosphor-icons/react/dist/ssr'
import { Ruku, Salah } from '@/components/icons'
import ProjectBanner from '@/components/project-banner.astro'
import PhotoGallery from '@/components/react/photo-gallery'
import { getProjectSummary, getGallery } from '@/lib/content'

const projectData = await getProjectSummary()
const mosqueGallery = await getGallery('mosquee-photos')

let membresActifs = 60
try {
  const res = await fetch(
    'https://script.google.com/macros/s/AKfycbxEPnCPCJ687vzXMDmc8M66COZmco0kuzTOcXXtMRZXG71dkaRTVNwMVoWXDFgrIQQmeQ/exec',
  )
  if (res.ok) {
    const data = await res.json()
    if (data.membres_actifs) membresActifs = data.membres_actifs
  }
} catch {
  // fallback to default value
}

// Transform gallery data for the component
const galleryData = mosqueGallery
  ? {
      ...mosqueGallery.data,
      photos: mosqueGallery.data.photos,
    }
  : null
---

<Layout
  title="À propos - ACMSI"
  description="Découvrez l'histoire, la mission et les valeurs de l'Association Culturelle Musulmane de Saint-Imier et de la mosquée Nur."
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-linear-to-b from-white/20 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl lg:text-5xl font-bold mb-3">
          À propos de la Mosquée Nur
        </h1>
        <p class="text-xl max-w-3xl mx-auto">
          Découvrez l&rsquo;histoire, la mission et les valeurs de
          l&rsquo;Association Culturelle Musulmane de Saint-Imier
        </p>
      </div>
    </div>
  </section>

  <!-- Histoire Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Notre Histoire</h2>
        <div class="text-lg space-y-6">
          <p>
            La mosquée Nur a été établie pour répondre aux besoins spirituels
            croissants de la communauté musulmane de Saint-Imier et des
            environs. Située au cœur du Jura bernois, elle représente un lieu de
            rassemblement, de prière et d&rsquo;apprentissage pour tous les
            musulmans de la région.
          </p>
          <p>
            Le nom &ldquo;Nur&rdquo; signifie &ldquo;lumière&rdquo; en arabe,
            symbolisant notre aspiration à être une source de guidance
            spirituelle et de paix dans notre communauté locale.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quelques chiffres -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Quelques chiffres</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <UsersThreeIcon
              className="w-8 h-8 text-gray-600"
              weight="duotone"
            />
          </div>
          <p class="text-3xl font-bold mb-1">~{membresActifs}</p>
          <p class="text-gray-600">Membres/Foyers</p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <ClockCounterClockwiseIcon
              className="w-8 h-8 text-gray-600"
              weight="duotone"
            />
          </div>
          <p class="text-3xl font-bold mb-1">1993</p>
          <p class="text-gray-600">
            Premi&egrave;re mosqu&eacute;e de St-Imier
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <MosqueIcon className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <p class="text-3xl font-bold mb-1">2023</p>
          <p class="text-gray-600">Mosqu&eacute;e Nur</p>
          <p class="text-sm text-gray-500">Rue de la Clef 45</p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <Salah className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <p class="text-3xl font-bold mb-1">~230</p>
          <p class="text-gray-600">Capacit&eacute; (pri&egrave;res)</p>
          <p class="text-sm text-gray-500">~150 hommes, ~70 femmes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery -->
  {
    galleryData && (
      <section class="pt-4 pb-16 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <PhotoGallery
            client:visible
            gallery={galleryData}
            maxCols={{ default: 2, md: 3 }}
            maxRows={2}
          />
        </div>
      </section>
    )
  }

  <!-- Mission Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-3">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Notre Mission</h2>
        <div class="text-lg space-y-6">
          <p>
            L&rsquo;Association Culturelle Musulmane de Saint-Imier (ACMSI) a
            pour mission de faciliter la pratique religieuse et de promouvoir
            l&rsquo;excellence dans la pratique religieuse et les relations
            humaines.
          </p>
          <p>
            Nous nous efforçons de créer un environnement accueillant où chaque
            membre de notre communauté peut grandir spirituellement, socialement
            et intellectuellement, tout en contribuant positivement à la société
            suisse.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valeurs Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Nos Valeurs</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <Ruku className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <h3 class="text-2xl font-semibold mb-4">Excellence Spirituelle</h3>
          <p>
            L&rsquo;excellence spirituelle est au cœur de tout ce que nous
            faisons. Nous nous efforçons d&rsquo;atteindre la perfection dans
            l&rsquo;adoration d&rsquo;Allah et dans nos relations avec autrui,
            en agissant avec conscience et dévotion.
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <UsersThreeIcon
              className="w-8 h-8 text-gray-600"
              weight="duotone"
            />
          </div>
          <h3 class="text-2xl font-semibold mb-4">Communauté</h3>
          <p>
            Nous valorisons l&rsquo;unité, la solidarité et l&rsquo;entraide au
            sein de notre communauté, créant des liens forts basés sur la
            fraternité islamique et le respect mutuel.
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <BookOpenIcon className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <h3 class="text-2xl font-semibold mb-4">Éducation</h3>
          <p>
            L&rsquo;apprentissage continu du Coran, de la langue arabe et des
            sciences islamiques est essentiel pour le développement spirituel et
            intellectuel de notre communauté.
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <HeartIcon className="w-8 h-8 text-gray-600" weight="duotone" />
          </div>
          <h3 class="text-2xl font-semibold mb-4">Accueil</h3>
          <p>
            Notre mosquée est ouverte à tous, musulmans et non-musulmans, dans
            un esprit de dialogue, de compréhension mutuelle et de respect des
            différences.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Banner -->
  <ProjectBanner
    variant="thin"
    showProgress={true}
    totalAmount={projectData?.total_objectif || 630000}
    raisedAmount={projectData?.total_leve || 0}
    percentage={projectData?.pourcentage_global || 0}
  />

  <!-- Contact CTA -->
  <section class="py-16 bg-gray-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4 text-white">Venez nous rencontrer</h2>
      <p class="text-xl text-gray-300 mb-8">
        Nous serions ravis de vous accueillir à la mosquée Nur pour découvrir
        notre communauté
      </p>
      <a
        href="/contact"
        class="bg-white text-gray-900 px-8 py-4 rounded-lg font-medium hover:bg-gray-100 transition-colors inline-block"
      >
        Nous contacter
      </a>
    </div>
  </section>
</Layout>
