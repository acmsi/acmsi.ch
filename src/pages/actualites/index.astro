---
import Layout from '@/layouts/Layout.astro'
import { getAllNews, getProjectSummary } from '@/lib/content'
import { Newspaper, X } from '@phosphor-icons/react/dist/ssr'
import ProjectBanner from '@/components/project-banner.astro'

// Enable server-side rendering for URL query parameter handling
export const prerender = false

const newsArticles = await getAllNews()
const projectData = await getProjectSummary()

// Get tag from URL query parameter
const url = Astro.url
const selectedTag = url.searchParams.get('tag') || undefined

// Filter articles by tag if specified
const filteredArticles = selectedTag
  ? newsArticles.filter(article => article.data.tags?.includes(selectedTag))
  : newsArticles

// Get all unique tags from all articles for the filter UI
const allTags = Array.from(
  new Set(newsArticles.flatMap(article => article.data.tags || [])),
).sort()
---

<Layout
  title="Actualités - ACMSI"
  description="Suivez les dernières actualités de l'Association Culturelle Musulmane de Saint-Imier et de la mosquée Nur."
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-linear-to-b from-white/20 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl lg:text-5xl font-bold mb-3">Actualités</h1>
        <p class="text-xl max-w-3xl mx-auto">
          Restez informés des dernières nouvelles de notre communauté, des
          événements à venir et des activités de la mosquée Nur.
        </p>

        <!-- Tag Filter -->
        {
          allTags.length > 0 && (
            <div class="mt-8">
              <div class="flex flex-wrap justify-center gap-2">
                <a
                  href="/actualites"
                  class={`px-3 py-1 rounded-full text-sm transition-colors ${
                    !selectedTag
                      ? 'bg-teal-100 text-teal-700 font-medium'
                      : 'bg-gray-100 text-gray-600 hover:bg-teal-50 hover:text-teal-600'
                  }`}
                >
                  Tous
                </a>
                {allTags.map(tag => (
                  <a
                    href={`/actualites?tag=${encodeURIComponent(tag)}`}
                    class={`px-3 py-1 rounded-full text-sm transition-colors ${
                      selectedTag === tag
                        ? 'bg-teal-100 text-teal-700 font-medium'
                        : 'bg-gray-100 text-gray-600 hover:bg-teal-50 hover:text-teal-600'
                    }`}
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- News Articles -->
  <section class="pb-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Results summary -->
      {
        selectedTag && (
          <div class="mb-6">
            <div class="flex items-center gap-2 text-sm text-gray-600">
              <span>Filtré par tag:</span>
              <span class="px-2 py-1 bg-teal-100 text-teal-700 rounded-full font-medium">
                {selectedTag}
              </span>
              <a
                href="/actualites"
                class="flex items-center gap-1 text-teal-600 hover:text-teal-700 transition-colors"
              >
                <X className="w-4 h-4" />
                Effacer le filtre
              </a>
            </div>
            <p class="text-sm text-gray-500 mt-1">
              {filteredArticles.length} article
              {filteredArticles.length !== 1 ? 's' : ''} trouvé
              {filteredArticles.length !== 1 ? 's' : ''}
            </p>
          </div>
        )
      }

      {
        filteredArticles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {filteredArticles.map(article => (
              <article class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                {article.data.featured_image && (
                  <div class="aspect-video bg-gray-100 relative">
                    <img
                      src={article.data.featured_image}
                      alt={article.data.title}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6">
                  <div class="flex items-center text-sm text-gray-500 mb-3">
                    <time datetime={article.data.date.toISOString()}>
                      {article.data.date.toLocaleDateString('fr-CH', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                    <span class="mx-2">•</span>
                    <span>{article.data.author}</span>
                  </div>

                  <h2 class="text-xl font-semibold mb-3">
                    <a
                      href={`/actualites/${article.id}`}
                      class="hover:text-teal-600 transition-colors"
                    >
                      {article.data.title}
                    </a>
                  </h2>

                  {article.data.excerpt && (
                    <p class="mb-4 line-clamp-3">{article.data.excerpt}</p>
                  )}

                  {article.data.tags && article.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {article.data.tags.map(tag => (
                        <a
                          href={`/actualites?tag=${encodeURIComponent(tag)}`}
                          class={`px-2 py-1 text-xs rounded-full transition-colors ${
                            selectedTag === tag
                              ? 'bg-teal-100 text-teal-700 font-medium'
                              : 'bg-gray-100 text-gray-600 hover:bg-teal-50 hover:text-teal-600'
                          }`}
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  )}

                  <a
                    href={`/actualites/${article.id}`}
                    class="text-teal-600 font-medium hover:text-teal-700 transition-colors"
                  >
                    Lire la suite →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <div class="w-16 h-16 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-6">
              <Newspaper className="w-8 h-8 text-gray-500" weight="duotone" />
            </div>
            <h3 class="text-xl font-semibold mb-4">
              {selectedTag
                ? `Aucune actualité avec le tag "${selectedTag}"`
                : 'Aucune actualité pour le moment'}
            </h3>
            <p class="mb-6">
              {selectedTag ? (
                <>
                  Essayez de{' '}
                  <a
                    href="/actualites"
                    class="text-teal-600 hover:text-teal-700 underline"
                  >
                    supprimer le filtre
                  </a>{' '}
                  pour voir toutes les actualités.
                </>
              ) : (
                'Les actualités seront bientôt disponibles. Revenez nous voir prochainement !'
              )}
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Project Banner -->
  <ProjectBanner
    variant="thin"
    showProgress={true}
    totalAmount={projectData?.total_objectif || 630000}
    raisedAmount={projectData?.total_leve || 0}
    percentage={projectData?.pourcentage_global || 0}
  />
</Layout>
