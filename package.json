{
  "name": "acmsi-website",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "license": "ISC",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/optimize-images.ts",
    "build": "astro build",
    "preview": "wrangler dev --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "test:unit": "node --test",
    "test:components": "playwright test -c playwright-ct.config.ts",
    "test:components:ui": "playwright test -c playwright-ct.config.ts --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:perf": "playwright test tests/e2e/performance.spec.ts --project=chromium",
    "test:perf:summary": "playwright test tests/e2e/performance.spec.ts --project=chromium --grep='generate comprehensive report'",
    "test:all": "npm run test:unit && npm run test:components && npm run test:e2e",
    "test": "npm run test:all",
    "cms-proxy": "decap-server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize-images": "node scripts/optimize-images.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/react": "^4.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^5.16.4",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/eslintrc": "^3",
    "@playwright/experimental-ct-react": "^1.57.0-alpha-2025-11-15",
    "@playwright/test": "^1.57.0-alpha-2025-11-15",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "decap-server": "^3.2.0",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.5.0",
    "playwright": "^1.57.0-alpha-2025-11-15",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-sort-json": "^4.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5",
    "typescript-eslint": "^8.49.0",
    "wrangler": "^4.54.0"
  },
  "prettier": {
    "semi": false,
    "arrowParens": "avoid",
    "singleQuote": true,
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-sort-json"
    ],
    "jsonRecursiveSort": true,
    "overrides": [
      {
        "files": "package.json",
        "options": {
          "printWidth": 120
        }
      },
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "engines": {
    "node": ">=25.2.0"
  }
}
