{
  // Wrangler configuration for Cloudflare Workers (Astro SSR)
  // https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "acmsi-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-12-08",
  "compatibility_flags": ["nodejs_compat"],
  // Enable workers.dev subdomain for preview URLs
  "workers_dev": true,
  // Reuse the existing session namespace instead of provisioning it on upload.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "91c454f4804444228d5adfac6f1ac0e9",
    },
  ],
  // Static assets configuration
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Custom domains (Cloudflare handles DNS and SSL automatically)
  "routes": [
    {
      "pattern": "acmsi.ch",
      "custom_domain": true,
      "zone_name": "acmsi.ch",
    },
    {
      "pattern": "www.acmsi.ch",
      "custom_domain": true,
      "zone_name": "acmsi.ch",
    },
  ],
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23li44CIi4JyQmBQhy",
  },
}
